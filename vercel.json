{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "Design-Assets/artifacts/aaru/dist/public"
      }
    },
    {
      "src": "AR-AI-Editor/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/AR-AI-Editor/server.js"
    },
    {
      "source": "/models/(.*)",
      "destination": "/AR-AI-Editor/server.js"
    },
    {
      "source": "/editor",
      "destination": "/AR-AI-Editor/server.js"
    },
    {
      "source": "/editor/(.*)",
      "destination": "/AR-AI-Editor/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
